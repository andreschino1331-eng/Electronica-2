/* ============================================================
 * VARIABLES DEL PROGRAMA
 * ============================================================ */

/* 0 = modo décadas
 * 1 = modo RGB
 */
uint8_t modo = 0;

/* Contador independiente para cada modo */
uint8_t contador_decadas = 0;
uint8_t contador_rgb = 0;


/* ============================================================
 * FUNCIONES
 * ============================================================ */

/* Mostrar el contador de décadas en los 4 LEDs */
void MostrarDecadas(uint8_t valor)
{
    HAL_GPIO_WritePin(LED1_GPIO_Port, LED1_Pin,
                      (valor & 0x01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(LED2_GPIO_Port, LED2_Pin,
                      (valor & 0x02) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(LED3_GPIO_Port, LED3_Pin,
                      (valor & 0x04) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(LED4_GPIO_Port, LED4_Pin,
                      (valor & 0x08) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}


/* ============================================================
 * CONTROL DEL LED RGB
 *
 * Tabla utilizada:
 *
 * 0 = Apagado
 * 1 = Rojo
 * 2 = Verde
 * 3 = Azul
 * 4 = Amarillo
 * 5 = Cian
 * 6 = Magenta
 * 7 = Blanco
 *
 * Si tu tabla de la clase es diferente, solamente modificamos
 * esta función.
 * ============================================================ */

void MostrarRGB(uint8_t valor)
{
    uint8_t rojo = GPIO_PIN_RESET;
    uint8_t verde = GPIO_PIN_RESET;
    uint8_t azul = GPIO_PIN_RESET;

    switch(valor)
    {
        case 0:
            /* Apagado */
            rojo = GPIO_PIN_RESET;
            verde = GPIO_PIN_RESET;
            azul = GPIO_PIN_RESET;
            break;

        case 1:
            /* Rojo */
            rojo = GPIO_PIN_SET;
            break;

        case 2:
            /* Verde */
            verde = GPIO_PIN_SET;
            break;

        case 3:
            /* Azul */
            azul = GPIO_PIN_SET;
            break;

        case 4:
            /* Amarillo = rojo + verde */
            rojo = GPIO_PIN_SET;
            verde = GPIO_PIN_SET;
            break;

        case 5:
            /* Cian = verde + azul */
            verde = GPIO_PIN_SET;
            azul = GPIO_PIN_SET;
            break;

        case 6:
            /* Magenta = rojo + azul */
            rojo = GPIO_PIN_SET;
            azul = GPIO_PIN_SET;
            break;

        case 7:
            /* Blanco = rojo + verde + azul */
            rojo = GPIO_PIN_SET;
            verde = GPIO_PIN_SET;
            azul = GPIO_PIN_SET;
            break;

        default:
            break;
    }

    HAL_GPIO_WritePin(Rojo_GPIO_Port, Rojo_Pin, rojo);
    HAL_GPIO_WritePin(Verde_GPIO_Port, Verde_Pin, verde);
    HAL_GPIO_WritePin(Azul_GPIO_Port, Azul_Pin, azul);
}


/* ============================================================
 * ACTUALIZAR LED INDICADOR
 *
 * Décadas = apagado
 * RGB     = encendido
 * ============================================================ */

void ActualizarIndicador(void)
{
    if(modo == 0)
    {
        HAL_GPIO_WritePin(LEDEXTRA_GPIO_Port,
                          LEDEXTRA_Pin,
                          GPIO_PIN_RESET);
    }
    else
    {
        HAL_GPIO_WritePin(LEDEXTRA_GPIO_Port,
                          LEDEXTRA_Pin,
                          GPIO_PIN_SET);
    }
}


/* ============================================================
 * ANTI-REBOTE
 *
 * Esperamos unos milisegundos después de detectar un botón.
 * Después comprobamos que siga presionado.
 * ============================================================ */

uint8_t BotonPresionado(GPIO_TypeDef *GPIOx, uint16_t GPIO_Pin)
{
    if(HAL_GPIO_ReadPin(GPIOx, GPIO_Pin) == GPIO_PIN_SET)
    {
        HAL_Delay(30);

        if(HAL_GPIO_ReadPin(GPIOx, GPIO_Pin) == GPIO_PIN_SET)
        {
            /* Esperar a que se suelte */
            while(HAL_GPIO_ReadPin(GPIOx, GPIO_Pin) == GPIO_PIN_SET)
            {
                HAL_Delay(1);
            }

            HAL_Delay(30);

            return 1;
        }
    }

    return 0;
}


/* ============================================================
 * CAMBIAR DE MODO
 * ============================================================ */

void CambiarModo(void)
{
    if(modo == 0)
    {
        /* Pasar de DÉCADAS a RGB */
        modo = 1;

        /* Mostrar inmediatamente el color guardado */
        MostrarRGB(contador_rgb);
    }
    else
    {
        /* Pasar de RGB a DÉCADAS */
        modo = 0;

        /* Mostrar inmediatamente el número guardado */
        MostrarDecadas(contador_decadas);
    }

    /* Actualizar LED indicador */
    ActualizarIndicador();
}


/* ============================================================
 * AUMENTAR CONTADOR
 * ============================================================ */

void Aumentar(void)
{
    if(modo == 0)
    {
        /* -------------------------------
         * MODO DÉCADAS
         * Contador circular 0-9
         * ------------------------------- */

        contador_decadas++;

        if(contador_decadas > 9)
        {
            contador_decadas = 0;
        }

        MostrarDecadas(contador_decadas);
    }
    else
    {
        /* -------------------------------
         * MODO RGB
         * Contador NO circular 0-7
         * ------------------------------- */

        if(contador_rgb < 7)
        {
            contador_rgb++;
        }

        MostrarRGB(contador_rgb);
    }
}


/* ============================================================
 * DISMINUIR CONTADOR
 * ============================================================ */

void Disminuir(void)
{
    if(modo == 0)
    {
        /* -------------------------------
         * MODO DÉCADAS
         * Contador circular 0-9
         * ------------------------------- */

        if(contador_decadas == 0)
        {
            contador_decadas = 9;
        }
        else
        {
            contador_decadas--;
        }

        MostrarDecadas(contador_decadas);
    }
    else
    {
        /* -------------------------------
         * MODO RGB
         * Contador NO circular 0-7
         * ------------------------------- */

        if(contador_rgb > 0)
        {
            contador_rgb--;
        }

        MostrarRGB(contador_rgb);
    }
}


