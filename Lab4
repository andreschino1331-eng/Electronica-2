/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */

  /* Inicializar el contador de décadas */
  MostrarDecadas(contador_decadas);

  /* Inicializar el RGB */
  MostrarRGB(contador_rgb);

  /* Inicializar indicador */
  ActualizarIndicador();

  /* USER CODE END 2 */


  /* Infinite loop */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* ========================================================
       * BOTÓN MODO
       * ======================================================== */

      if(BotonPresionado(Modo_GPIO_Port, Modo_Pin))
      {
          CambiarModo();
      }


      /* ========================================================
       * BOTÓN AUMENTAR
       * ======================================================== */

      if(BotonPresionado(Aumentar_GPIO_Port, Aumentar_Pin))
      {
          Aumentar();
      }


      /* ========================================================
       * BOTÓN DISMINUIR
       * ======================================================== */

      if(BotonPresionado(Disminuir_GPIO_Port, Disminuir_Pin))
      {
          Disminuir();
      }


      HAL_Delay(1);

      /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */

