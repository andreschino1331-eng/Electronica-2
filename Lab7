// Escala de cada potenciómetro (0 - 4095) a su signo vital
#define FC_ESC_MIN      30     // Frecuencia cardiaca: 30 - 200 bpm
#define FC_ESC_MAX      200
#define SPO2_ESC_MIN    70     // Oxigenación (SpO2): 70 - 100 %
#define SPO2_ESC_MAX    100
#define TEMP_ESC_MIN    340    // Temperatura: 34.0 - 42.0 °C (en décimas)
#define TEMP_ESC_MAX    420

// Parte 4: rango normal. Fuera de [MIN, MAX] se enciende el LED correspondiente
#define FC_MIN          60     // LED1: frecuencia cardiaca (bpm)
#define FC_MAX          100
#define SPO2_MIN        95     // LED2: oxigenación (%)
#define SPO2_MAX        100
#define TEMP_MIN        360    // LED3: temperatura (décimas de °C) -> 36.0
#define TEMP_MAX        375    //                                   -> 37.5
/* USER CODE END PD */

