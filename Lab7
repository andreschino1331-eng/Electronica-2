/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  // Inicia el ADC en modo continuo con DMA circular: 3 conversiones (PA0, PA1, PA4)
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buf, 3);
  Mostrar_Menu();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    // El DMA actualiza adc_buf solo; aquí solo se copian a variables con nombre
    pot1 = adc_buf[0];
    pot2 = adc_buf[1];
    pot3 = adc_buf[2];

    // Conversión del ADC a signos vitales (enteros)
    fc     = FC_ESC_MIN   + (pot1 * (FC_ESC_MAX   - FC_ESC_MIN))   / 4095;
    spo2   = SPO2_ESC_MIN + (pot2 * (SPO2_ESC_MAX - SPO2_ESC_MIN)) / 4095;
    temp10 = TEMP_ESC_MIN + (pot3 * (TEMP_ESC_MAX - TEMP_ESC_MIN)) / 4095;

    // Parte 4: evalúa los rangos y controla los LEDs en cada vuelta del loop
    Evaluar_Alarmas();

    // ---- Parte 3: menú por UART ----
    // Revisa si llegó un caracter (timeout 0 = no bloquea el programa)
    if (HAL_UART_Receive(&huart2, &rx_char, 1, 0) == HAL_OK)
    {
      if (rx_char >= '1' && rx_char <= '4')
      {
        opcion = rx_char - '0';
        UART_Print("\r\n--- Lecturas (M = volver al menu) ---\r\n");
        t_ultimo = 0;   // fuerza que se imprima de inmediato
      }
      else if (rx_char == 'm' || rx_char == 'M')
      {
        opcion = 0;
        Mostrar_Menu();
      }
      else if (rx_char != '\r' && rx_char != '\n')
      {
        opcion = 0;
        UART_Print("\r\nOpcion invalida.\r\n");
        Mostrar_Menu();
      }
    }
    __HAL_UART_CLEAR_OREFLAG(&huart2);   // limpia error de overrun si se tecleó muy rápido

    // Imprime cada 200 ms solo lo que el usuario eligió
    if (opcion != 0 && (HAL_GetTick() - t_ultimo) >= 200)
    {
      t_ultimo = HAL_GetTick();
      int len = 0;

      switch (opcion)
      {
        case 1:
          len = snprintf(tx_buf, sizeof(tx_buf), "Ritmo cardiaco: %3d bpm\r\n", fc);
          break;
        case 2:
          len = snprintf(tx_buf, sizeof(tx_buf), "Oxigenacion: %3d %%\r\n", spo2);
          break;
        case 3:
          len = snprintf(tx_buf, sizeof(tx_buf), "Temperatura: %d.%d C\r\n", temp10 / 10, temp10 % 10);
          break;
        case 4:
          len = snprintf(tx_buf, sizeof(tx_buf),
                         "FC: %3d bpm | SpO2: %3d %% | Temp: %d.%d C\r\n",
                         fc, spo2, temp10 / 10, temp10 % 10);
          break;
      }
      HAL_UART_Transmit(&huart2, (uint8_t*)tx_buf, len, 100);
    }
    /* USER CODE END 3 */
  }
}

