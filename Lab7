volatile uint16_t adc_buf[3];   // Lo llena el DMA: [0]=PA0 (Pot1), [1]=PA1 (Pot2), [2]=PA4 (Pot3)
volatile uint16_t pot1, pot2, pot3;
int fc, spo2, temp10;           // Signos vitales: bpm, %, décimas de °C
char tx_buf[100];               // Buffer de texto para enviar por UART
uint8_t rx_char;                // Caracter recibido por UART (opción del menú)
volatile uint8_t opcion = 0;    // 0 = esperando opción, 1-3 = un pot, 4 = los tres
uint32_t t_ultimo = 0;          // Marca de tiempo del último envío (ms)
