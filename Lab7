// Parte 4: LED encendido si la señal está fuera de su rango, apagado si está dentro
static void Evaluar_Alarmas(void)
{
  HAL_GPIO_WritePin(LED1_GPIO_Port, LED1_Pin,
                    (fc < FC_MIN || fc > FC_MAX) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(LED2_GPIO_Port, LED2_Pin,
                    (spo2 < SPO2_MIN || spo2 > SPO2_MAX) ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(LED3_GPIO_Port, LED3_Pin,
                    (temp10 < TEMP_MIN || temp10 > TEMP_MAX) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}
